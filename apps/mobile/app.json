{
  "expo": {
    "name": "WokThai",
    "owner": "mchaaben",
    "slug": "wokthai",
    "scheme": "wokthai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wokthai.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.wokthai.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "order-status"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WokThai utilise votre position pour enregistrer les coordonnées de livraison."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eeabf0c9-9147-41e5-a43d-d82443a4314e"
      }
    }
  }
}
